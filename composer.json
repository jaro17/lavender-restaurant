{
    "name": "lavender/restaurant-admin",
    "description": "Minimal Slim 4 admin backend for a restaurant website",
    "type": "project",
    "require": {
        "slim/slim": "^4",
        "slim/psr7": "^1",
        "slim/twig-view": "^3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "serve": "php -S localhost:8080 -t public",
        "init-db": "php bin/init-db.php"
    }
}
