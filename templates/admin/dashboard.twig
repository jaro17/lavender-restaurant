{% extends "layout.twig" %}

{% block content %}
    <section class="card">
        <h1>{{ siteName }}</h1>
        <p>Ste prihlásený do administrácie cez session-based autentifikáciu.</p>

        <div class="status">
            <p><strong>Aktuálny používateľ:</strong> {{ currentUser.username }}</p>
            <p><strong>Autentifikácia:</strong> chránená admin route, login formulár, logout a overenie používateľa v SQLite sú aktívne.</p>
            <p><strong>Týždenné menu:</strong> upravíte ho v <a href="/admin/menu">Týždennom menu</a>.</p>
            <p><strong>Nastavenia naposledy upravené:</strong> {{ settingsUpdatedAt ?: 'Zatiaľ nebolo upravené' }}</p>
            <p><strong>Health check:</strong> <code>/api/health</code></p>
        </div>
    </section>
{% endblock %}
